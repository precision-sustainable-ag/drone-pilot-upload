Bootstrap: docker
From: node:22-bookworm-slim
Stage: frontend

%files
    frontend/package.json /opt/src/frontend/package.json
    frontend/public /opt/src/frontend/public
    frontend/src /opt/src/frontend/src

%post
    set -eu

    cd /opt/src/frontend
    npm install --no-audit --no-fund

    export PUBLIC_URL=.
    export REACT_APP_API_URL=./imgproc

    npm run build


Bootstrap: docker
From: python:3.14-slim-trixie
Stage: runtime

%labels
    Author Precision Sustainable Agriculture
    Description Drone Pilot Upload Python 3.14 application

%environment
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1

%files
    backend/requirements.txt /opt/drone-pilot-upload/backend/requirements.txt
    backend/app.py /opt/drone-pilot-upload/backend/app.py
    backend/utils.py /opt/drone-pilot-upload/backend/utils.py
    backend/storage.py /opt/drone-pilot-upload/backend/storage.py
    backend/dataSync.py /opt/drone-pilot-upload/backend/dataSync.py
    backend/passenger_wsgi.py /opt/drone-pilot-upload/backend/passenger_wsgi.py
    backend/example.config.py /opt/drone-pilot-upload/backend/example.config.py

%files from frontend
    /opt/src/frontend/build /opt/drone-pilot-upload/frontend/build

%post
    set -eu

    apt-get update
    apt-get install -y --no-install-recommends \
        default-jre-headless \
        libimage-exiftool-perl

    rm -rf /var/lib/apt/lists/*

    python -m pip install --upgrade pip

    python -m pip install --no-cache-dir \
        --only-binary=:all: \
        -r /opt/drone-pilot-upload/backend/requirements.txt

    cp /opt/drone-pilot-upload/backend/example.config.py \
       /opt/drone-pilot-upload/backend/config.py

%runscript
    cd /opt/drone-pilot-upload/backend

    exec gunicorn \
        --bind "0.0.0.0:${PORT:-8000}" \
        --workers 1 \
        --timeout 0 \
        app:app
