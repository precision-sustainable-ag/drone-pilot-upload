#!/usr/bin/env bash

# Start Drone Pilot Upload inside a Ceres Slurm allocation.

set -euo pipefail

dpu="/project/dash_drone/user/stephen.amerige/projects/github/precision-sustainable-ag/drone-pilot-upload"
data_root="/project/dash_drone/user/stephen.amerige/dpu-data"

sif="${dpu}/sif_files/drone-pilot-upload.next.sif"
log_file="${data_root}/logs/ceres-sandbox/app.log"

echo "Starting Drone Pilot Upload on Ceres"
echo "Compute node: $(hostname)"
echo "Slurm job: ${SLURM_JOB_ID}"
echo "Port: ${port}"
echo "SIF: ${sif}"

module load apptainer/1.4.1

### VALIDATION
if [[ ! -r "${sif}" ]]; then
    echo "Application image is not readable: ${sif}" >&2
    exit 1
fi

### APPLICATION LOGGING
mkdir -p "$(dirname "${log_file}")"

if [[ ! -w "$(dirname "${log_file}")" ]]; then
    echo "Application log directory is not writable" >&2
    exit 1
fi

### LAUNCH APPLICATION
exec apptainer run \
    --env PORT="${port}" \
    --env DPU_DATA_ROOT="${data_root}" \
    --env DPU_ID_DIR=site-id \
    --env DPU_NAME_DIR=site-name \
    --env DPU_MONGODB_MODE=queue \
    --env DPU_LOG_FILE="${log_file}" \
    "${sif}"
