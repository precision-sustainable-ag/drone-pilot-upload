#!/usr/bin/env bash

# Start the real Drone Pilot Upload application inside the Slurm allocation.

set -euo pipefail

dpu="/project/dash_drone/user/stephen.amerige/projects/github/precision-sustainable-ag/drone-pilot-upload"
sif="${dpu}/sif_files/drone-pilot-upload-current.sif"

echo "Starting Drone Pilot Upload"
echo "Compute node: $(hostname)"
echo "Slurm job: ${SLURM_JOB_ID}"
echo "Port: ${port}"
echo "SIF: ${sif}"

module load apptainer/1.4.3

### APPLICATION LOGGING
log_file="/project/dash_drone/user/stephen.amerige/dpu-data/logs/atlas-sandbox/app.log"

mkdir -p "$(dirname "${log_file}")"

if [[ ! -w "$(dirname "${log_file}")" ]]; then
    echo "Application log directory is not writable" >&2
    exit 1
fi

### LAUNCH APPLICATION
exec apptainer run \
    --env PORT="${port}" \
    --env DPU_DATA_ROOT=/project/dash_drone/user/stephen.amerige/dpu-data \
    --env DPU_ID_DIR=site-id \
    --env DPU_NAME_DIR=site-name \
    --env DPU_MONGODB_DATABASE=drone-pilot-atlas-sandbox \
    --env DPU_MONGODB_COLLECTION=flight-information \
    --env DPU_MONGODB_MODE=queue \
    --env DPU_LOG_FILE="${log_file}" \
    "${sif}"
